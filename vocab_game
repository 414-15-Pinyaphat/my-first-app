import time
import streamlit as st

st.set_page_config(page_title="เกมเติมศัพท์จับเวลา", page_icon="⏱️")

st.title("⏱️ เกมเติมศัพท์จับเวลา")
st.write("เติมตัวอักษรให้ครบทั้ง 4 ข้อ ภายในเวลา 30 วินาที!")

# -----------------------------
# ตั้งค่าเริ่มต้น
# -----------------------------
if "answers" not in st.session_state:
    st.session_state.answers = ["", "", "", ""]

if "start" not in st.session_state:
    st.session_state.start = None

if "is_ended" not in st.session_state:
    st.session_state.is_ended = False


# -----------------------------
# เริ่มเกมใหม่
# -----------------------------
def reset_game():
    st.session_state.answers = ["", "", "", ""]
    st.session_state.start = time.time()
    st.session_state.is_ended = False


# -----------------------------
# ตรวจคำตอบ
# -----------------------------
def check_answer(answer, correct):
    return answer.strip().lower() == correct.lower()


# -----------------------------
# แสดงผลลัพธ์
# -----------------------------
@st.dialog("📊 สรุปผลการเล่นเกม")
def show_result_dialog():
    correct_answers = ["apple", "fish", "school", "banana"]
    score = 0

    st.balloons()

    for i, (user_answer, correct_answer) in enumerate(
        zip(st.session_state.answers, correct_answers), start=1
    ):
        if check_answer(user_answer, correct_answer):
            st.success(f"✅ ข้อ {i}: ถูกต้อง")
            score += 1
        else:
            st.error(
                f"❌ ข้อ {i}: ผิด — "
                f"คำตอบที่ถูกคือ `{correct_answer}`"
            )

    st.info(f"🏆 คะแนนรวม: {score}/4 คะแนน")

    if score == 4:
        st.success("🎉 You Win! เก่งมาก!")
    elif score >= 2:
        st.warning("😊 เกือบชนะแล้ว พยายามอีกนิด!")
    else:
        st.error("💀 You Lose! ลองใหม่อีกครั้ง")


# -----------------------------
# ปุ่มเริ่มเกม
# -----------------------------
st.button(
    "🎮 เริ่มเล่นเกม",
    on_click=reset_game,
    use_container_width=True
)


# -----------------------------
# แสดงเวลา
# -----------------------------
if (
    st.session_state.start is not None
    and not st.session_state.is_ended
):
    elapsed = time.time() - st.session_state.start
    time_left = max(0, int(30 - elapsed))

    if time_left > 0:
        st.error(f"⏳ เหลือเวลา: {time_left} วินาที")
    else:
        st.session_state.is_ended = True
        st.rerun()


st.divider()


# -----------------------------
# ช่องตอบคำถาม
# -----------------------------
disabled = (
    st.session_state.start is None
    or st.session_state.is_ended
)

questions = [
    "ข้อ 1: An `a _ _ l e` a day keeps the doctor away. 🍎",
    "ข้อ 2: Cats love to eat `f _ s h`. 🐟",
    "ข้อ 3: Students go to `s _ h o o l` every day. 🏫",
    "ข้อ 4: Monkeys love to eat `b _ n a n a`. 🍌",
]

for i, question in enumerate(questions):
    st.session_state.answers[i] = st.text_input(
        question,
        value=st.session_state.answers[i],
        disabled=disabled,
        key=f"answer_{i})


# -----------------------------
# ปุ่มส่งคำตอบ
# -----------------------------
if not disabled:
    if st.button(
        "📥 ส่งคำตอบ",
        use_container_width=True
    ):
        st.session_state.is_ended = True
        st.rerun()

    # นับเวลาทุก 1 วินาที
    time.sleep(1)
    st.rerun()


# -----------------------------
# แสดงผลลัพธ์
# -----------------------------
if st.session_state.is_ended:
    show_result_dialog()


st.divider()
st.write("👩‍🎓 นางสาวภิญญาพัชญ์ อภิรภัทร์วโรดม เลขที่ 15 ม.4/14")
